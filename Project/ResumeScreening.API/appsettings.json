{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ResumeScreeningDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_THIS_WITH_A_STRONG_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "ResumeScreeningAPI",
    "Audience": "ResumeScreeningUI",
    "ExpiryInHours": 8
  },
  "AzureBlobStorage": {
    "ConnectionString": "REPLACE_WITH_YOUR_AZURE_BLOB_CONNECTION_STRING",
    "ContainerName": "resume-files"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": "http://localhost:4200;https://localhost:4200;http://127.0.0.1:4200"
}
